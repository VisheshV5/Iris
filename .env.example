# --- A1Mobile telephony ---
A1_BASE_URL=https://hack.a1mobile.com
A1_TEAM_KEY=
A1_PHONE_NUMBER=
A1_SIP_USERNAME=
A1_SIP_PASSWORD=

# --- A1 AI gateway (OpenAI Responses API) ---
AI_GATEWAY_BASE_URL=
AI_GATEWAY_KEY=
IRIS_MODEL=openai.gpt-5.6-terra
# "a1" routes Iris's brain through the hackathon gateway (non-streaming, ~2s/turn);
# anything else uses Vapi-native streaming gpt-4.1-mini (~500ms).
IRIS_LLM=openai

# --- Google OAuth (same client as the Supabase dashboard's Google provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vapi ---
VAPI_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# Wearer's real phone — "I've got it" transfers the live call here
WEARER_PHONE=

# --- Iris behavior ---
IRIS_MODE=busy

# --- Server ---
PORT=3333
PUBLIC_URL=

# Outbound-call consent allowlist (A1 rules: OTP-verified numbers only), comma-separated E.164
VERIFIED_OUTBOUND_NUMBERS=
# All reservation calls dial this stand-in line (demo constraint — see README)
RESTAURANT_DEMO_NUMBER=
